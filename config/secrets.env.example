# ============================================================
# Angel One SmartAPI — Secrets Template
# Copy this file to config/secrets.env and fill in your values.
# NEVER commit secrets.env to version control.
# ============================================================

# Angel One API credentials
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here        # e.g. A123456
ANGEL_PASSWORD=your_login_password_here
ANGEL_TOTP_SECRET=your_base32_totp_secret  # From Angel One TOTP setup page

# Telegram (optional but strongly recommended for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here     # From @BotFather
TELEGRAM_CHAT_ID=your_telegram_chat_id_here         # Your personal chat ID
